      "weighted_features": [
        { "field": "cold_sensation", "operator": "==", "value": "yes", "weight": 3, "label": "明显怕冷" },
        { "field": "lower_abdomen_pain", "operator": "==", "value": true, "weight": 3, "label": "小腹/盆腔疼痛" },
        { "field": "warmth_relief", "operator": "==", "value": "yes", "weight": 2, "label": "热敷后缓解" },
        { "field": "clot_presence", "operator": "==", "value": "yes", "weight": 2, "label": "有血块" },
        { "field": "blood_color", "operator": "in", "value": ["dark_red", "brown"], "weight": 1, "label": "经血暗红或棕色" }
      ],
      "minimum_score": 6,
      "intervention_tags": ["warmth", "gentle_movement", "food_level"]
    },
    {
